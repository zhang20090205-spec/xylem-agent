# WalletConnect Project ID for HashConnect
# Get your project ID from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Hedera Network Configuration
# Options: 'mainnet', 'testnet', 'previewnet'
VITE_HEDERA_NETWORK=mainnet

# Hackathon demo wallet
# Defaults to true. Set to false to require a real HashConnect wallet again.
VITE_DEMO_WALLET_ENABLED=true
VITE_DEMO_ACCOUNT_ID=0.0.5864846
VITE_DEMO_WALLET_BALANCE_HBAR=2500

# WebSocket Configuration
# Local development WebSocket URL
VITE_WEBSOCKET_URL_LOCAL=ws://localhost:8080
# Production WebSocket URL (Railway handles port routing automatically)
# Leave empty to use the deployed site's same-origin /ws endpoint.
VITE_WEBSOCKET_URL_PRODUCTION=
# Note: Environment is detected automatically by Vite
